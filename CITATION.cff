    authors:
      - family-names: Shiu
        given-names: Peter Man-Kit
    title: "A Brun–Titchmarsh theorem for multiplicative functions"
    year: 1980
    journal: "Journal für die reine und angewandte Mathematik"
    volume: "313"
    start: "161"
    end: "170"
  - type: thesis
    authors:
      - family-names: Shiu
        given-names: Peter Man-Kit
    title: "Studies in Multiplicative Number Theory"
    year: 1980
    institution:
      name: "University of Nottingham"
    url: "https://eprints.nottingham.ac.uk/28304/1/281269.pdf"
  - type: software
    title: "selberg-sieve4"
    authors:
      - family-names: Mellendijk
        given-names: Arend
    url: "https://github.com/amellendijk/selberg-sieve4"
